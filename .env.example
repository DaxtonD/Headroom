# Headroom environment variables
# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit real values.
# The API validates these at startup and refuses to run with a missing value or a "change-me" placeholder.

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
NODE_ENV=production
# The exact HTTPS address you open the app at (cookies, CORS and the PWA depend on it).
# Example with Tailscale: https://headroom.your-tailnet.ts.net
APP_ORIGIN=https://change-me.example
# Port the app listens on inside the container
PORT=3000
# Interface the app binds to INSIDE the container. Leave as 0.0.0.0: what
# actually limits reachability is APP_BIND_ADDRESS further down.
HOST=0.0.0.0
# Where the built web app lives. Set by the Docker image; leave blank for
# local development, where Vite serves the app instead.
WEB_DIST_DIR=
# Saskatchewan time, no daylight saving
TZ=America/Regina
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------------------------------------------------------------
# Database (PostgreSQL)
#
# The POSTGRES_* values below are used ONLY when Headroom runs its own
# database container (docker compose --profile with-db). When you point
# DATABASE_URL at a Postgres server you already run, they are ignored.
# ---------------------------------------------------------------
POSTGRES_DB=headroom
POSTGRES_USER=headroom
# Long random value: openssl rand -hex 24  (hex avoids URL-encoding problems)
POSTGRES_PASSWORD=change-me
# The connection string Prisma and the app use. This is the one value you must
# get right.
#   - Using an existing Postgres server (plain `docker compose up`):
#       point this at that server, e.g.
#       postgresql://user:password@192.168.1.50:5432/headroom?schema=public
#   - Letting Headroom run its own Postgres (`docker compose --profile with-db up`):
#       keep host `db`, and keep the three POSTGRES_* values above in sync with it.
DATABASE_URL=postgresql://headroom:change-me@db:5432/headroom?schema=public
# Optional. Only needed for `prisma migrate dev` when the database user is not
# allowed to create the temporary shadow database itself. Not used in production.
SHADOW_DATABASE_URL=

# ---------------------------------------------------------------
# Sessions and login
# ---------------------------------------------------------------
# 64 hex chars: openssl rand -hex 32
SESSION_SECRET=change-me
# Long-lived because the app is opened many times a day
SESSION_TTL_DAYS=90
# Must stay true in production (HTTPS only)
COOKIE_SECURE=true
# Failed login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# ---------------------------------------------------------------
# Sync and integrity (see docs/HANDOFF.md section 16)
# ---------------------------------------------------------------
# How long to remember Idempotency-Key responses
IDEMPOTENCY_KEY_TTL_HOURS=48
# Keep-alive interval for the live-update stream
SSE_HEARTBEAT_SECONDS=25
# How often to extend every household's upcoming items. The ledger runs to a
# horizon that moves forward every day, so this keeps it filled even in a week
# when nobody edits anything. Idempotent: it creates nothing when nothing is
# due. Also runs once at startup.
GENERATION_SWEEP_HOURS=6

# ---------------------------------------------------------------
# Web Push notifications (optional, milestone M5)
# Generate once: npx web-push generate-vapid-keys
# ---------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address for the push service, e.g. mailto:admin@your-domain
VAPID_SUBJECT=

# ---------------------------------------------------------------
# Backups (pg_dump sidecar)
# ---------------------------------------------------------------
# Cron schedule in TZ above: 3:00 AM daily
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------
# Unraid host settings (used by docker-compose.yml, not by the app)
# ---------------------------------------------------------------
# Postgres data lives here
APPDATA_DIR=/mnt/user/appdata/headroom
# Nightly dumps land here
BACKUP_HOST_DIR=/mnt/user/backups/headroom
# Host port mapped to the app (pick one not used by other containers)
APP_HOST_PORT=8484
# Bind to this host address. 127.0.0.1 or your Tailscale IP keeps it off the open internet.
APP_BIND_ADDRESS=127.0.0.1
# Unraid's standard nobody:users ids for files written to appdata
PUID=99
PGID=100
# Image tag to run (e.g. a release tag pushed to GHCR)
IMAGE_TAG=latest
