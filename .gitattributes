# Normalize to LF in the repo; the Docker image and backup scripts run on Linux.
* text=auto eol=lf

*.sh      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.prisma  text eol=lf
*.sql     text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.ico binary
*.woff binary
*.woff2 binary
