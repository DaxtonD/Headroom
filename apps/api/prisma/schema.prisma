// Headroom data model (HANDOFF section 8).
//
// Rules this schema enforces:
//  - All money is `BigInt` cents. No Float or Decimal for money, anywhere.
//  - Only facts are stored. Running balances, safe-to-spend, left-over and
//    coverage are never columns; @headroom/core derives them.
//  - Every mutable row carries `version` for optimistic concurrency, plus
//    updatedBy/updatedAt and soft delete. Nothing vanishes without a trace.
//  - balance_snapshot and activity are insert-only, enforced by triggers in a
//    migration rather than by convention alone.
//  - Dates where only the day matters are `@db.Date`; instants are timestamptz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 moved connection URLs out of the schema: migrate reads them from
// prisma.config.ts, and PrismaClient takes a driver adapter (see src/db.ts).
datasource db {
  provider = "postgresql"
}

/* -------------------------------------------------------------------------- */
/* Enums                                                                      */
/* -------------------------------------------------------------------------- */

enum TemplateKind {
  paycheque
  bill
  deposit
  transfer
}

enum ScheduleType {
  monthly
  monthly_last
  relative_to_pay
  biweekly
  flexible
}

/// How an occurrence is placed on the timeline (HANDOFF section 6.2).
///
/// auto     = placed by DATE. Automatic withdrawals, auto deposits and
///            paycheques are all `auto`: the bank acts on a known day and the
///            money has to be there. A paycheque is not a withdrawal, but it
///            is dated, and that is what this field decides.
/// flexible = placed by ANCHOR, with no date. Attached to a paycheque and
///            movable to an earlier or later one when money is tight; a null
///            anchor means "now", before the first upcoming paycheque.
///
/// A database CHECK enforces auto <=> dated and flexible <=> undated, so the
/// timeline ordering can never be ambiguous.
enum WithdrawalKind {
  auto
  flexible
}

enum BudgetSection {
  income
  fixed
  variable
}

enum AssetKind {
  asset
  liability
}

/// What an account is for.
///
/// Until there was a savings screen the household had exactly one account, and
/// "the chequing account" meant "the first account row". That was fine with one
/// row and silently wrong with two: the timeline would have gone on reading
/// whichever row was created first, so a savings balance could have been
/// mistaken for the money available to spend. The kind is now stated rather
/// than inferred from creation order.
enum AccountKind {
  chequing
  savings
}

/// What a pot of savings is for. Only one pot can sensibly feed the mortgage
/// payoff projection, but nothing in the schema enforces that: the household
/// may want to see two mortgage pots side by side while deciding.
enum EarmarkPurpose {
  general
  mortgage_lump_sum
}

/// How a quoted annual mortgage rate becomes a per-period rate.
///
/// `simple_division` divides by the number of payments a year, which is what
/// the household's own spreadsheet does, and the default so the two agree.
/// `semi_annual` is the Canadian convention a lender actually uses. The
/// difference is a couple of hundred dollars of interest across the remaining
/// term and does not move the payoff date by one payment.
enum RateCompounding {
  simple_division
  semi_annual
}

/// The window a prepayment allowance resets on. Dax confirmed the household's
/// runs on the calendar year, which is why a lump sum can land in late
/// December just before the reset.
enum PrivilegePeriod {
  calendar_year
}

enum PayCadence {
  biweekly
}

/// HANDOFF section 14 question 8. The default reproduces the spreadsheet.
enum WeekendWithdrawalRule {
  as_scheduled
  friday_before
  next_business_day
}

enum ActivityAction {
  create
  update
  verify
  unverify
  clear
  unclear
  move
  soft_delete
  restore
  snapshot
}

/* -------------------------------------------------------------------------- */
/* Household and people                                                      */
/* -------------------------------------------------------------------------- */

model Household {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  timezone String @default("America/Regina")
  currency String @default("CAD")

  /// How much must remain after an automatic withdrawal for it to count as
  /// covered. Section 14 question 5; default 0.
  cushionCents BigInt @default(0)

  /// Section 14 question 7. The default reproduces the spreadsheet horizon.
  horizonRule           String @default("through_day_before_nth_paycheque")
  horizonPaychequeCount Int    @default(4)

  weekendWithdrawalRule WeekendWithdrawalRule @default(as_scheduled)

  /// Carol's stated net income for the Budget screen (HANDOFF section 4.3).
  /// The yearly figure is NOT monthly x 12 - hers do not agree exactly, and
  /// section 14 q2 says to use her numbers as given rather than reconcile
  /// them. So both are stored, and both are editable.
  netMonthlyIncomeCents BigInt @default(0)
  netYearlyIncomeCents  BigInt @default(0)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  users              User[]
  accounts           Account[]
  templates          Template[]
  occurrences        Occurrence[]
  budgetLines        BudgetLine[]
  goals              Goal[]
  reimbursements     Reimbursement[]
  assets             Asset[]
  activities         Activity[]
  bankedHours        BankedHoursEntry[]
  mortgages          Mortgage[]
  retirementSettings RetirementSettings?

  @@map("household")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  householdId  String @db.Uuid
  name         String
  /// Single letter shown in the avatar bubble.
  initial      String @db.VarChar(2)
  email        String @unique
  passwordHash String
  /// Design tokens for this person's initial bubble.
  colorFg      String @default("#3F4844")
  colorBg      String @default("#ECEAE3")

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household        Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sessions         Session[]
  paySchedules     PaySchedule[]
  ownedTemplates   Template[]         @relation("templateOwner")
  ownedOccurrences Occurrence[]       @relation("occurrenceOwner")
  verifiedOccurrences Occurrence[]    @relation("occurrenceVerifier")
  clearedOccurrences  Occurrence[]    @relation("occurrenceClearer")
  snapshots        BalanceSnapshot[]
  bankedHours      BankedHoursEntry[]
  activities       Activity[]
  idempotencyKeys  IdempotencyKey[]

  @@index([householdId])
  @@map("user")
}

/// Opaque server-side sessions. The cookie carries only this row's id, signed.
model Session {
  id         String   @id @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/* -------------------------------------------------------------------------- */
/* Accounts and balances                                                      */
/* -------------------------------------------------------------------------- */

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  householdId String      @db.Uuid
  name        String
  /// Defaults to chequing, which is what every existing row is.
  kind        AccountKind @default(chequing)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  snapshots BalanceSnapshot[]
  /// Templates that transfer INTO this account. A savings account is an
  /// ordinary Account row; nothing distinguishes it but what points at it.
  transfersIn Template[]      @relation("templateTransferTarget")

  @@index([householdId])
  @@map("account")
}

/// INSERT-ONLY. A correction is a new row; the latest `asOf` wins.
model BalanceSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  cents       BigInt
  asOf        DateTime @db.Timestamptz(6)
  enteredById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  note        String?

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enteredBy User    @relation(fields: [enteredById], references: [id])

  @@index([accountId, asOf])
  @@map("balance_snapshot")
}

/* -------------------------------------------------------------------------- */
/* Schedules, templates and occurrences                                       */
/* -------------------------------------------------------------------------- */

model PaySchedule {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  cadence      PayCadence @default(biweekly)
  /// Any real payday; every other payday is 14 days from here.
  anchorDate   DateTime   @db.Date
  defaultCents BigInt

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mortgages Mortgage[]

  @@index([userId])
  @@map("pay_schedule")
}

model Template {
  id           String         @id @default(uuid()) @db.Uuid
  householdId  String         @db.Uuid
  kind         TemplateKind
  name         String
  defaultCents BigInt
  /// Who receives this bill. Null means the UI shows "Set who gets this bill"
  /// (section 14 question 4 default).
  ownerUserId  String?        @db.Uuid
  withdrawal   WithdrawalKind
  scheduleType ScheduleType
  /// Shape depends on scheduleType: {day}, {user, offsetDays}, {anchorDate},
  /// {frequency}. Validated with Zod at the edge, never trusted raw.
  scheduleJson Json
  section      BudgetSection?
  budgetLineId String?        @db.Uuid

  /// Set this and the template stops being a bill: it is a transfer into that
  /// account.
  ///
  /// The savings line was modelled as a bill, which made it look like an
  /// obligation competing with everything else. Dax, 2026-11-08: "The savings
  /// of $1300 is a goal we set. She decides when and how much we allocate." So
  /// `defaultCents` is the household's per-period TARGET, and each occurrence's
  /// own amount is what was actually decided that period. Target against actual
  /// then falls out of machinery that already exists, including the
  /// estimate-versus-verified badge, which reads as proposed versus decided.
  ///
  /// On the ledger a transfer behaves exactly like a bill - the money really
  /// does leave chequing - so nothing about the running balance changes.
  transferToAccountId String? @db.Uuid

  /// The monthly budget figure, when the derived one is not wanted.
  ///
  /// Headroom works out what a recurring bill costs per month from its
  /// cadence (biweekly is 26 times a year, so 26/12 of the amount). Where
  /// Carol's sheet states a different figure, hers is the spec, and this
  /// holds it. Null means use the derived figure.
  monthlyBudgetOverrideCents BigInt?

  /// False archives it: generation stops and it leaves the budget, but every
  /// past occurrence, amount and verification stays intact. Nothing in
  /// Headroom is deleted outright.
  active       Boolean        @default(true)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household         Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner             User?        @relation("templateOwner", fields: [ownerUserId], references: [id])
  budgetLine        BudgetLine?  @relation(fields: [budgetLineId], references: [id])
  transferToAccount Account?     @relation("templateTransferTarget", fields: [transferToAccountId], references: [id], onDelete: Restrict)
  occurrences       Occurrence[]

  @@index([householdId, active])
  @@map("template")
}

model Occurrence {
  id          String  @id @default(uuid()) @db.Uuid
  householdId String  @db.Uuid
  templateId  String? @db.Uuid
  /// Identifies which recurrence this is, for example "2026-11". Unique per
  /// template, so generating the same period twice can never duplicate a row.
  periodKey   String?

  name  String
  cents BigInt
  kind  TemplateKind

  /// Dated items (automatic withdrawals, auto deposits, paycheques) have a
  /// date. Flexible items have an anchor paycheque instead; a null anchor
  /// means "now", before the first upcoming paycheque.
  date               DateTime?      @db.Date
  anchorOccurrenceId String?        @db.Uuid
  sortIndex          Int            @default(0)
  withdrawal         WithdrawalKind
  isOneOff           Boolean        @default(false)
  ownerUserId        String?        @db.Uuid

  verifiedById String?   @db.Uuid
  verifiedAt   DateTime? @db.Timestamptz(6)
  clearedById  String?   @db.Uuid
  clearedAt    DateTime? @db.Timestamptz(6)

  version     Int       @default(1)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household  Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  template   Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  owner      User?        @relation("occurrenceOwner", fields: [ownerUserId], references: [id])
  // Who entered the real amount, and who marked it paid. The other person has
  // to be able to see this clearly (HANDOFF section 5 rule 5).
  verifiedBy User?        @relation("occurrenceVerifier", fields: [verifiedById], references: [id])
  clearedBy  User?        @relation("occurrenceClearer", fields: [clearedById], references: [id])
  anchor     Occurrence?  @relation("anchorChildren", fields: [anchorOccurrenceId], references: [id], onDelete: SetNull)
  anchored   Occurrence[] @relation("anchorChildren")

  @@unique([templateId, periodKey], name: "template_period_unique")
  @@index([householdId, date])
  @@index([householdId, clearedAt])
  @@index([anchorOccurrenceId, sortIndex])
  @@map("occurrence")
}

/* -------------------------------------------------------------------------- */
/* Budget, goals, net worth, retirement                                       */
/* -------------------------------------------------------------------------- */

model BudgetLine {
  id           String        @id @default(uuid()) @db.Uuid
  householdId  String        @db.Uuid
  section      BudgetSection
  name         String
  monthlyCents BigInt
  /// Set only where the yearly figure is not monthly x 12.
  yearlyCentsOverride BigInt?
  sortIndex    Int           @default(0)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  templates Template[]

  @@index([householdId, section])
  @@map("budget_line")
}

/// An earmark: money already in the savings account, labelled with what it is
/// for. The household has exactly one real savings account, so this is a label
/// and not a transfer - nothing here moves money.
///
/// `savedCents` and the account's own balance snapshots are both facts, neither
/// derived from the other, so they can disagree. That disagreement is the
/// useful number (see `computeSavings` in @headroom/core) and is reported
/// rather than hidden.
model Goal {
  id          String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  name        String

  /// What it is being saved towards, when there is a figure at all.
  ///
  /// Null is the normal case for a trip. Dax, 2026-11-08: "Trips never have a
  /// set date or set cost. We simply save for it and book a good deal when it
  /// comes about." An app that demands a target makes someone invent one and
  /// then reports progress against a number nobody believes.
  targetCents BigInt?
  savedCents  BigInt @default(0)

  /// Lets the savings screen find the pot that feeds the mortgage payoff
  /// projection without a household setting pointing at a UUID.
  purpose     EarmarkPurpose @default(general)
  sortIndex   Int            @default(0)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("goal")
}

/// The mortgage, as terms rather than as a schedule.
///
/// Only the facts are stored. The amortization schedule, the payoff date, the
/// total interest and what another lump sum would buy are all derived by
/// `@headroom/core/mortgage` on demand and never persisted - same rule as
/// running balances.
///
/// One row per household in practice; not enforced, because a second mortgage
/// is a real thing and refusing to store one would be worse than allowing it.
model Mortgage {
  id          String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid

  /// Balance owing immediately after the payment on `asOf`.
  balanceCents BigInt
  /// The date of the payment that produced `balanceCents`.
  asOf         DateTime @db.Date

  /// The annual rate in whole basis points: 525 is 5.25%. An integer, so no
  /// float is involved in pricing a period.
  rateBasisPoints Int
  /// The regular payment, as a positive magnitude.
  paymentCents    BigInt

  /// How the fortnightly payment dates are decided. One of two ways.
  ///
  /// EITHER it follows a payday: the payment comes out a fixed number of days
  /// after one, so it is biweekly like the pay it follows, and that offset is
  /// the reason a month can hold three paycheques but only two mortgage
  /// payments.
  ///
  /// OR it has its own anchor: any real payment date, with the rest every
  /// fourteen days from it. This is what a lender actually gives you, and it
  /// matters because a payday-anchored mortgage silently moves every payment
  /// if that pay anchor is ever corrected.
  payScheduleId String?   @db.Uuid
  offsetDays    Int       @default(1)
  anchorDate    DateTime? @db.Date

  periodsPerYear Int             @default(26)
  cadenceDays    Int             @default(14)
  compounding    RateCompounding @default(simple_division)

  /// The prepayment allowance, and the window it resets on.
  prepaymentCapCents BigInt          @default(0)
  privilegePeriod    PrivilegePeriod @default(calendar_year)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paySchedule  PaySchedule? @relation(fields: [payScheduleId], references: [id], onDelete: Restrict)
  prepayments  Prepayment[]

  @@index([householdId])
  @@map("mortgage")
}

/// A lump sum paid against the mortgage, or planned.
///
/// Versioned and soft-deletable like the rest, not trigger-enforced
/// append-only: a figure typed from a bank statement needs correcting
/// sometimes, and the audit trail lives in `activity`. What matters is that the
/// total used against the allowance is DERIVED from these rows and never
/// stored, so the two can never drift.
model Prepayment {
  id         String @id @default(uuid()) @db.Uuid
  mortgageId String @db.Uuid

  paidOn DateTime @db.Date
  /// Positive magnitude.
  cents  BigInt
  note   String?

  /// False for a lump sum that is planned but has not been made yet, which is
  /// how next year's intention is modelled without claiming it happened.
  paid Boolean @default(true)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  mortgage Mortgage @relation(fields: [mortgageId], references: [id], onDelete: Cascade)

  @@index([mortgageId, paidOn])
  @@map("prepayment")
}

/// Work purchases put on the Visa and tracked until reimbursed.
model Reimbursement {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  purchase    String
  cents       BigInt
  boughtOn    DateTime  @db.Date
  submittedAt DateTime? @db.Timestamptz(6)
  paidAt      DateTime? @db.Timestamptz(6)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("reimbursement")
}

/// Hours only, no dollar conversion (section 14 question 11).
model BankedHoursEntry {
  id          String  @id @default(uuid()) @db.Uuid
  householdId String  @db.Uuid
  userId      String  @db.Uuid
  /// Hours to two decimals. Not money, so Decimal is the right type here.
  hours       Decimal @db.Decimal(6, 2)
  note        String?

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([userId])
  @@map("banked_hours_entry")
}

model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  kind        AssetKind
  name        String
  cents       BigInt
  asOf        DateTime? @db.Date
  note        String?
  sortIndex   Int       @default(0)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, kind])
  @@map("asset")
}

/// All retirement inputs are editable settings, never constants in code.
model RetirementSettings {
  householdId String @id @db.Uuid

  rrspCurrentPlusContribCents   BigInt
  mortgageMonthlyCents          BigInt
  redirectYears                 Int
  flatGrowthPct                 Int
  /// Off by default: the sheet applies the growth once (section 14 q3).
  compoundYearly                Boolean @default(false)
  drawdownYears                 Int
  govPensionAnnualCents         BigInt
  retirementExpensesAnnualCents BigInt

  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedById String?  @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("retirement_settings")
}

/* -------------------------------------------------------------------------- */
/* History and idempotency (HANDOFF section 16)                               */
/* -------------------------------------------------------------------------- */

/// APPEND-ONLY. Drives per-item history, the "who changed what" notices,
/// undo, and the conflict detection in section 16.3.
model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  householdId String         @db.Uuid
  userId      String         @db.Uuid
  at          DateTime       @default(now()) @db.Timestamptz(6)
  action      ActivityAction
  entity      String
  entityId    String         @db.Uuid
  /// The row version this change produced, so a conflict check can ask what
  /// happened since the version the client saw.
  versionAfter Int
  /// Exactly which fields this change touched. Same-field overlap is a 409;
  /// no overlap auto-merges.
  fields      String[]
  beforeJson  Json?
  afterJson   Json?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([entity, entityId, versionAfter])
  @@index([householdId, at])
  @@map("activity")
}

/// One row per mutating request. A replay returns the stored response; the
/// same key with a different body is a 422. Purged after the configured TTL.
model IdempotencyKey {
  key          String   @id @db.Uuid
  userId       String   @db.Uuid
  method       String
  path         String
  requestHash  String
  statusCode   Int
  responseJson Json
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("idempotency_key")
}
