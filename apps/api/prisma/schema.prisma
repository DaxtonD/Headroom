// Headroom data model (HANDOFF section 8).
//
// Rules this schema enforces:
//  - All money is `BigInt` cents. No Float or Decimal for money, anywhere.
//  - Only facts are stored. Running balances, safe-to-spend, left-over and
//    coverage are never columns; @headroom/core derives them.
//  - Every mutable row carries `version` for optimistic concurrency, plus
//    updatedBy/updatedAt and soft delete. Nothing vanishes without a trace.
//  - balance_snapshot and activity are insert-only, enforced by triggers in a
//    migration rather than by convention alone.
//  - Dates where only the day matters are `@db.Date`; instants are timestamptz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 moved connection URLs out of the schema: migrate reads them from
// prisma.config.ts, and PrismaClient takes a driver adapter (see src/db.ts).
datasource db {
  provider = "postgresql"
}

/* -------------------------------------------------------------------------- */
/* Enums                                                                      */
/* -------------------------------------------------------------------------- */

enum TemplateKind {
  paycheque
  bill
  deposit
  transfer
}

enum ScheduleType {
  monthly
  monthly_last
  /// The same month and day every year: annual insurance, a yearly
  /// subscription. Dated, so it is an automatic withdrawal like `monthly`.
  yearly
  relative_to_pay
  biweekly
  flexible
}

/// How an occurrence is placed on the timeline (HANDOFF section 6.2).
///
/// auto     = placed by DATE. Automatic withdrawals, auto deposits and
///            paycheques are all `auto`: the bank acts on a known day and the
///            money has to be there. A paycheque is not a withdrawal, but it
///            is dated, and that is what this field decides.
/// flexible = placed by ANCHOR, with no date. Attached to a paycheque and
///            movable to an earlier or later one when money is tight; a null
///            anchor means "now", before the first upcoming paycheque.
///
/// A database CHECK enforces auto <=> dated and flexible <=> undated, so the
/// timeline ordering can never be ambiguous.
enum WithdrawalKind {
  auto
  flexible
}

enum BudgetSection {
  income
  fixed
  variable
}

enum AssetKind {
  asset
  liability
}

/// What an account is for.
///
/// Until there was a savings screen the household had exactly one account, and
/// "the chequing account" meant "the first account row". That was fine with one
/// row and silently wrong with two: the timeline would have gone on reading
/// whichever row was created first, so a savings balance could have been
/// mistaken for the money available to spend. The kind is now stated rather
/// than inferred from creation order.
///
/// `credit_card` is an account whose balance is money OWED rather than held.
/// Its snapshots store that debt as a positive magnitude, the same convention
/// `Asset` already uses for a liability: the kind says whether a figure is
/// owned or owed, so no amount in this database is ever a negative balance.
enum AccountKind {
  chequing
  savings
  credit_card
}

/// What a pot of savings is for. Only one pot can sensibly feed the mortgage
/// payoff projection, but nothing in the schema enforces that: the household
/// may want to see two mortgage pots side by side while deciding.
enum EarmarkPurpose {
  general
  mortgage_lump_sum
}

/// How a quoted annual mortgage rate becomes a per-period rate.
///
/// `simple_division` divides by the number of payments a year, which is what
/// the household's own spreadsheet does, and the default so the two agree.
/// `semi_annual` is the Canadian convention a lender actually uses. The
/// difference is a couple of hundred dollars of interest across the remaining
/// term and does not move the payoff date by one payment.
enum RateCompounding {
  simple_division
  semi_annual
}

/// The window a prepayment allowance resets on. Confirmed that this
/// household's runs on the calendar year, which is why a lump sum can land in late
/// December just before the reset.
enum PrivilegePeriod {
  calendar_year
}

enum PayCadence {
  biweekly
}

/// HANDOFF section 14 question 8. The default reproduces the spreadsheet.
enum WeekendWithdrawalRule {
  as_scheduled
  friday_before
  next_business_day
}

enum ActivityAction {
  create
  update
  verify
  unverify
  clear
  unclear
  move
  soft_delete
  restore
  snapshot
}

/* -------------------------------------------------------------------------- */
/* Household and people                                                      */
/* -------------------------------------------------------------------------- */

model Household {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  timezone String @default("America/Regina")
  currency String @default("CAD")

  /// How much must remain after an automatic withdrawal for it to count as
  /// covered. Section 14 question 5; default 0.
  cushionCents BigInt @default(0)

  /// Section 14 question 7. The default reproduces the spreadsheet horizon.
  horizonRule           String @default("through_day_before_nth_paycheque")
  horizonPaychequeCount Int    @default(4)

  weekendWithdrawalRule WeekendWithdrawalRule @default(as_scheduled)

  /// The household's stated net income for the Budget screen (HANDOFF 4.3).
  /// The yearly figure is NOT monthly x 12 - the two do not agree exactly, and
  /// section 14 q2 says to use the stated numbers as given rather than reconcile
  /// them. So both are stored, and both are editable.
  netMonthlyIncomeCents BigInt @default(0)
  netYearlyIncomeCents  BigInt @default(0)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  users              User[]
  accounts           Account[]
  templates          Template[]
  occurrences        Occurrence[]
  budgetLines        BudgetLine[]
  goals              Goal[]
  reimbursements     Reimbursement[]
  assets             Asset[]
  activities         Activity[]
  bankedHours        BankedHoursEntry[]
  mortgages          Mortgage[]
  retirementSettings RetirementSettings?
  images             Image[]

  @@map("household")
}

/// An uploaded picture: the little square beside a name.
///
/// INSERT-ONLY and content-addressed. `sha256` is the hash of the bytes, so
/// re-cropping makes a new row rather than changing one, and the same picture
/// given to two things is stored once. An id therefore never comes to mean
/// different bytes, which is what lets `/api/images/:id` be cached for ever
/// and what makes the service worker's copy safe to keep.
///
/// The bytes live in the database rather than on a volume, and the reason that
/// matters is the backup: the household's is a Duplicati job pointed at a
/// folder of database dumps, so anything on a filesystem would sit outside it
/// and nobody would find out until they needed it. It also means no new volume
/// mapping on the server. A cropped icon is some 15KB, so the whole set is
/// smaller than one dump.
///
/// Nothing here is derived and nothing here is money. This table cannot affect
/// a figure: `packages/core` does not know it exists.
model Image {
  id          String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  /// Lower-case hex SHA-256 of `bytes`, unique within the household.
  sha256      String @db.Char(64)
  bytes       Bytes
  /// Always `image/webp`. The picker encodes it, so there is one decoder path
  /// and nothing has to trust what a client claims a file is.
  contentType String
  width       Int
  height      Int
  byteSize    Int

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdById String?  @db.Uuid

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accounts    Account[]
  templates   Template[]
  budgetLines BudgetLine[]

  @@unique([householdId, sha256])
  @@index([householdId])
  @@map("image")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  householdId  String @db.Uuid
  name         String
  /// Single letter shown in the avatar bubble.
  initial      String @db.VarChar(2)
  email        String @unique
  passwordHash String
  /// Design tokens for this person's initial bubble.
  colorFg      String @default("#3F4844")
  colorBg      String @default("#ECEAE3")

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household        Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sessions         Session[]
  paySchedules     PaySchedule[]
  ownedTemplates   Template[]         @relation("templateOwner")
  ownedOccurrences Occurrence[]       @relation("occurrenceOwner")
  verifiedOccurrences Occurrence[]    @relation("occurrenceVerifier")
  paidOccurrences     Occurrence[]    @relation("occurrencePayer")
  clearedOccurrences  Occurrence[]    @relation("occurrenceClearer")
  snapshots        BalanceSnapshot[]
  bankedHours      BankedHoursEntry[]
  activities       Activity[]
  idempotencyKeys  IdempotencyKey[]
  pushSubscriptions PushSubscription[]
  preferences      UserPreference?

  @@index([householdId])
  @@map("user")
}

/// How the app looks for one person: theme, text size, ledger density.
///
/// Per user rather than per household - two people share the money, not their
/// eyes - and on the server rather than only in the browser, which is the
/// change asked for on 2026-11-21: one of the two clears their browser cache
/// every day, so a choice kept only in `localStorage` had to be made again
/// every morning - "I'd like to store the user preferences in the server and
/// load on login. Then we don't lose the theme, font size or view settings."
///
/// Not versioned and not logged, unlike every other table here, and that is
/// deliberate rather than an oversight. The versioning rules exist so that two
/// people editing the same money fact cannot silently overwrite each other;
/// this row has exactly one writer by construction, holds no money, and a 409
/// on a theme is a question nobody can answer. `push_subscription` is the
/// existing precedent for a per-person device fact written the same plain way.
///
/// The row is created when somebody first changes something, so its absence is
/// a real answer: it means this person has never chosen, and the device may
/// seed it with whatever it already had in `localStorage`.
model UserPreference {
  userId String @id @db.Uuid

  /// A theme name the web app knows, or `system` to follow the device.
  theme         String @default("daylight") @db.VarChar(16)
  /// The text-size STEP's name, not its multiplier. The table of multipliers
  /// lives in `appearance.ts`, and a number here would be a second copy of it
  /// that drifts the first time a step changes.
  textSize      String @default("largest") @db.VarChar(16)
  /// `comfortable` or `compact`: how tightly the ledger packs its rows.
  ledgerDensity String @default("comfortable") @db.VarChar(16)

  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

/// Opaque server-side sessions. The cookie carries only this row's id, signed.
model Session {
  id         String   @id @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/* -------------------------------------------------------------------------- */
/* Accounts and balances                                                      */
/* -------------------------------------------------------------------------- */

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  householdId String      @db.Uuid
  name        String
  /// Defaults to chequing, which is what every existing row is.
  kind        AccountKind @default(chequing)
  /// The square beside the name. Null is the default, and what every existing
  /// row is.
  imageId     String?     @db.Uuid

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  image     Image?            @relation(fields: [imageId], references: [id], onDelete: SetNull)
  snapshots BalanceSnapshot[]
  /// Templates that transfer INTO this account. A savings account is an
  /// ordinary Account row; nothing distinguishes it but what points at it.
  transfersIn Template[]      @relation("templateTransferTarget")
  /// Everything whose money comes OUT of this account. A charge on a credit
  /// card and a bill out of chequing are the same row with a different source,
  /// which is what keeps a card charge from draining the chequing forecast.
  paidFromTemplates   Template[]   @relation("templatePaidFrom")
  paidFromOccurrences Occurrence[] @relation("occurrencePaidFrom")
  /// One-off transfers INTO this account: a card payment entered by hand has
  /// no template to inherit a destination from.
  transfersInOccurrences Occurrence[] @relation("occurrenceTransferTarget")

  @@index([householdId])
  @@index([imageId])
  @@map("account")
}

/// INSERT-ONLY. A correction is a new row; the latest `asOf` wins.
model BalanceSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  cents       BigInt
  asOf        DateTime @db.Timestamptz(6)
  enteredById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  note        String?

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enteredBy User    @relation(fields: [enteredById], references: [id])

  @@index([accountId, asOf])
  @@map("balance_snapshot")
}

/* -------------------------------------------------------------------------- */
/* Schedules, templates and occurrences                                       */
/* -------------------------------------------------------------------------- */

model PaySchedule {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  cadence      PayCadence @default(biweekly)
  /// Any real payday; every other payday is 14 days from here.
  anchorDate   DateTime   @db.Date
  defaultCents BigInt

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mortgages Mortgage[]

  @@index([userId])
  @@map("pay_schedule")
}

model Template {
  id           String         @id @default(uuid()) @db.Uuid
  householdId  String         @db.Uuid
  kind         TemplateKind
  name         String
  defaultCents BigInt
  /// Who receives this bill. Null means the UI shows "Set who gets this bill"
  /// (section 14 question 4 default).
  ownerUserId  String?        @db.Uuid
  withdrawal   WithdrawalKind
  scheduleType ScheduleType
  /// Shape depends on scheduleType: {day}, {month, day}, {user, offsetDays},
  /// {anchorDate}, {frequency}. Validated with Zod at the edge, never trusted
  /// raw.
  scheduleJson Json
  section      BudgetSection?
  budgetLineId String?        @db.Uuid
  /// The square beside the name. Null is the default.
  imageId      String?        @db.Uuid

  /// Set this and the template stops being a bill: it is a transfer into that
  /// account.
  ///
  /// The savings line was modelled as a bill, which made it look like an
  /// obligation competing with everything else. Answered 2026-11-08: the
  /// regular transfer "is a goal we set", and the household decides when and
  /// how much to allocate. So `defaultCents` is the per-period TARGET, and each occurrence's
  /// own amount is what was actually decided that period. Target against actual
  /// then falls out of machinery that already exists, including the
  /// estimate-versus-verified badge, which reads as proposed versus decided.
  ///
  /// On the ledger a transfer behaves exactly like a bill - the money really
  /// does leave chequing - so nothing about the running balance changes.
  transferToAccountId String? @db.Uuid

  /// Which account this leaves. Null means chequing, which is what every row
  /// was before cards existed.
  ///
  /// A charge on a credit card is an ordinary bill with this set. It keeps its
  /// own date, its own amount and its own budget section - it is a real
  /// monthly cost and belongs in the budget exactly as before - but it moves
  /// no chequing money, because none moves. The chequing outflow is the
  /// payment toward the card, which is its own row.
  ///
  /// So the budget counts the charges and the ledger counts the payment. Give
  /// a card-payment template a `section` as well and the same money is
  /// budgeted twice.
  paidFromAccountId String? @db.Uuid

  /// The monthly budget figure, when the derived one is not wanted.
  ///
  /// Headroom works out what a recurring bill costs per month from its
  /// cadence (biweekly is 26 times a year, so 26/12 of the amount). Where
  /// the household's sheet states a different figure, that is the spec, and
  /// this holds it. Null means use the derived figure.
  monthlyBudgetOverrideCents BigInt?

  /// False archives it: generation stops and it leaves the budget, but every
  /// past occurrence, amount and verification stays intact. Nothing in
  /// Headroom is deleted outright.
  active       Boolean        @default(true)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household         Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner             User?        @relation("templateOwner", fields: [ownerUserId], references: [id])
  budgetLine        BudgetLine?  @relation(fields: [budgetLineId], references: [id])
  image             Image?       @relation(fields: [imageId], references: [id], onDelete: SetNull)
  transferToAccount Account?     @relation("templateTransferTarget", fields: [transferToAccountId], references: [id], onDelete: Restrict)
  paidFromAccount   Account?     @relation("templatePaidFrom", fields: [paidFromAccountId], references: [id], onDelete: Restrict)
  occurrences       Occurrence[]

  @@index([householdId, active])
  @@index([paidFromAccountId])
  @@index([imageId])
  @@map("template")
}

model Occurrence {
  id          String  @id @default(uuid()) @db.Uuid
  householdId String  @db.Uuid
  templateId  String? @db.Uuid
  /// Identifies which recurrence this is, for example "2026-11". Unique per
  /// template, so generating the same period twice can never duplicate a row.
  periodKey   String?

  name  String
  cents BigInt
  kind  TemplateKind

  /// Dated items (automatic withdrawals, auto deposits, paycheques) have a
  /// date. Flexible items have an anchor paycheque instead; a null anchor
  /// means "now", before the first upcoming paycheque.
  date               DateTime?      @db.Date
  anchorOccurrenceId String?        @db.Uuid
  sortIndex          Int            @default(0)
  withdrawal         WithdrawalKind
  isOneOff           Boolean        @default(false)
  ownerUserId        String?        @db.Uuid

  /// The two ends of the move. Null `paidFromAccountId` means chequing.
  ///
  /// Set only `paidFromAccountId` and this is money leaving that account: a
  /// bill, or a charge on a card. Set `transferToAccountId` as well and it is
  /// a transfer, so one tick moves two balances - chequing down and the card's
  /// debt down by the same amount. That is what makes a payment toward a card
  /// recordable at all.
  ///
  /// Both are copied from the template on generation, and both are editable on
  /// the row, because a one-off payment has no template to inherit from.
  paidFromAccountId   String? @db.Uuid
  transferToAccountId String? @db.Uuid

  /// Set and this row IS a lump sum off the mortgage.
  ///
  /// The mortgage is not an `Account`, so it cannot be a `transferToAccountId`
  /// - there is no balance here for the money to arrive in, only a loan to be
  /// made smaller. This column is what says where it went.
  ///
  /// It is also the whole record of the payment. The Savings screen derives
  /// its lump sums from these rows rather than keeping a second copy in
  /// `Prepayment`, so editing the amount, moving the date, ticking it paid or
  /// deleting it on the ledger all reach the payoff projection with nothing to
  /// keep in step. `Prepayment` goes on holding lump sums that are only
  /// INTENDED, which move no money and have no row.
  mortgageId          String? @db.Uuid

  verifiedById String?   @db.Uuid
  verifiedAt   DateTime? @db.Timestamptz(6)

  /// "We have dealt with this." A tick for the two people, and nothing else:
  /// the row stays on the timeline and goes on being counted, because whether
  /// the money has left is decided by the bank balance somebody types in, not
  /// by a tick. Keeping the two apart is what stops a bill being subtracted
  /// twice - once inside the balance read off the bank, and once by marking it
  /// paid afterwards.
  paidById     String?   @db.Uuid
  paidAt       DateTime? @db.Timestamptz(6)

  /// "This is already inside the balance that was typed in", so the timeline
  /// must stop counting it. Set only by the balance-update checklist, which is
  /// the one place that knows what the typed figure included.
  clearedById  String?   @db.Uuid
  clearedAt    DateTime? @db.Timestamptz(6)

  /// When a person last changed this row's own details - the amount, the name,
  /// the date, where it hangs, who it belongs to. Null means every detail is
  /// still exactly what the template produced, so generation may bring it into
  /// line with a later edit to that template. Set, and generation leaves it
  /// alone for good: it is somebody's own figure now.
  customisedAt DateTime? @db.Timestamptz(6)

  version     Int       @default(1)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household  Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  template   Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  owner      User?        @relation("occurrenceOwner", fields: [ownerUserId], references: [id])
  // Who entered the real amount, and who marked it paid. The other person has
  // to be able to see this clearly (HANDOFF section 5 rule 5).
  verifiedBy User?        @relation("occurrenceVerifier", fields: [verifiedById], references: [id])
  paidBy     User?        @relation("occurrencePayer", fields: [paidById], references: [id])
  clearedBy  User?        @relation("occurrenceClearer", fields: [clearedById], references: [id])
  anchor     Occurrence?  @relation("anchorChildren", fields: [anchorOccurrenceId], references: [id], onDelete: SetNull)
  anchored   Occurrence[] @relation("anchorChildren")
  paidFromAccount   Account?  @relation("occurrencePaidFrom", fields: [paidFromAccountId], references: [id], onDelete: Restrict)
  transferToAccount Account?  @relation("occurrenceTransferTarget", fields: [transferToAccountId], references: [id], onDelete: Restrict)
  mortgage          Mortgage? @relation(fields: [mortgageId], references: [id], onDelete: Cascade)

  @@unique([templateId, periodKey], name: "template_period_unique")
  @@index([householdId, date])
  /// The Savings screen reads every lump sum for one mortgage on every load.
  @@index([mortgageId, date])
  @@index([householdId, clearedAt])
  @@index([anchorOccurrenceId, sortIndex])
  /// Both ends are foreign keys with ON DELETE RESTRICT, so removing an
  /// account has to check them. Postgres does not index a referencing column
  /// on its own.
  @@index([paidFromAccountId])
  @@index([transferToAccountId])
  @@map("occurrence")
}

/* -------------------------------------------------------------------------- */
/* Budget, goals, net worth, retirement                                       */
/* -------------------------------------------------------------------------- */

model BudgetLine {
  id           String        @id @default(uuid()) @db.Uuid
  householdId  String        @db.Uuid
  section      BudgetSection
  name         String
  monthlyCents BigInt
  /// Set only where the yearly figure is not monthly x 12.
  yearlyCentsOverride BigInt?
  sortIndex    Int           @default(0)
  /// The square beside the name. Null is the default.
  imageId      String?       @db.Uuid

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  image     Image?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  templates Template[]

  @@index([householdId, section])
  @@index([imageId])
  @@map("budget_line")
}

/// An earmark: money already in the savings account, labelled with what it is
/// for. The household has exactly one real savings account, so this is a label
/// and not a transfer - nothing here moves money.
///
/// `savedCents` and the account's own balance snapshots are both facts, neither
/// derived from the other, so they can disagree. That disagreement is the
/// useful number (see `computeSavings` in @headroom/core) and is reported
/// rather than hidden.
model Goal {
  id          String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid
  name        String

  /// What it is being saved towards, when there is a figure at all.
  ///
  /// Null is the normal case for a trip. Answered 2026-11-08: "Trips never
  /// have a set date or set cost. We simply save for it and book a good deal when it
  /// comes about." An app that demands a target makes someone invent one and
  /// then reports progress against a number nobody believes.
  targetCents BigInt?
  savedCents  BigInt @default(0)

  /// Lets the savings screen find the pot that feeds the mortgage payoff
  /// projection without a household setting pointing at a UUID.
  purpose     EarmarkPurpose @default(general)
  sortIndex   Int            @default(0)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("goal")
}

/// The mortgage, as terms rather than as a schedule.
///
/// Only the facts are stored. The amortization schedule, the payoff date, the
/// total interest and what another lump sum would buy are all derived by
/// `@headroom/core/mortgage` on demand and never persisted - same rule as
/// running balances.
///
/// One row per household in practice; not enforced, because a second mortgage
/// is a real thing and refusing to store one would be worse than allowing it.
model Mortgage {
  id          String @id @default(uuid()) @db.Uuid
  householdId String @db.Uuid

  /// Balance owing immediately after the payment on `asOf`.
  balanceCents BigInt
  /// The date of the payment that produced `balanceCents`.
  asOf         DateTime @db.Date

  /// The annual rate in whole basis points: 525 is 5.25%. An integer, so no
  /// float is involved in pricing a period.
  rateBasisPoints Int
  /// The regular payment, as a positive magnitude.
  paymentCents    BigInt

  /// How the fortnightly payment dates are decided. One of two ways.
  ///
  /// EITHER it follows a payday: the payment comes out a fixed number of days
  /// after one, so it is biweekly like the pay it follows, and that offset is
  /// the reason a month can hold three paycheques but only two mortgage
  /// payments.
  ///
  /// OR it has its own anchor: any real payment date, with the rest every
  /// fourteen days from it. This is what a lender actually gives you, and it
  /// matters because a payday-anchored mortgage silently moves every payment
  /// if that pay anchor is ever corrected.
  payScheduleId String?   @db.Uuid
  offsetDays    Int       @default(1)
  anchorDate    DateTime? @db.Date

  periodsPerYear Int             @default(26)
  cadenceDays    Int             @default(14)
  compounding    RateCompounding @default(simple_division)

  /// The prepayment allowance, and the window it resets on.
  prepaymentCapCents BigInt          @default(0)
  privilegePeriod    PrivilegePeriod @default(calendar_year)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paySchedule  PaySchedule? @relation(fields: [payScheduleId], references: [id], onDelete: Restrict)
  prepayments  Prepayment[]
  /// Lump sums actually paid: one ledger row each. See `Occurrence.mortgageId`.
  payments     Occurrence[]

  @@index([householdId])
  @@map("mortgage")
}

/// A lump sum paid against the mortgage, or planned.
///
/// Versioned and soft-deletable like the rest, not trigger-enforced
/// append-only: a figure typed from a bank statement needs correcting
/// sometimes, and the audit trail lives in `activity`. What matters is that the
/// total used against the allowance is DERIVED from these rows and never
/// stored, so the two can never drift.
model Prepayment {
  id         String @id @default(uuid()) @db.Uuid
  mortgageId String @db.Uuid

  paidOn DateTime @db.Date
  /// Positive magnitude.
  cents  BigInt
  note   String?

  /// False for a lump sum that is planned but has not been made yet, which is
  /// how next year's intention is modelled without claiming it happened.
  paid Boolean @default(true)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  mortgage Mortgage @relation(fields: [mortgageId], references: [id], onDelete: Cascade)

  @@index([mortgageId, paidOn])
  @@map("prepayment")
}

/// Work purchases put on the Visa and tracked until reimbursed.
model Reimbursement {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  purchase    String
  cents       BigInt
  boughtOn    DateTime  @db.Date
  submittedAt DateTime? @db.Timestamptz(6)
  paidAt      DateTime? @db.Timestamptz(6)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("reimbursement")
}

/// Hours only, no dollar conversion (section 14 question 11).
model BankedHoursEntry {
  id          String  @id @default(uuid()) @db.Uuid
  householdId String  @db.Uuid
  userId      String  @db.Uuid
  /// Hours to two decimals. Not money, so Decimal is the right type here.
  hours       Decimal @db.Decimal(6, 2)
  note        String?

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([userId])
  @@map("banked_hours_entry")
}

model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  kind        AssetKind
  name        String
  cents       BigInt
  asOf        DateTime? @db.Date
  note        String?
  sortIndex   Int       @default(0)

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedById String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?   @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, kind])
  @@map("asset")
}

/// All retirement inputs are editable settings, never constants in code.
model RetirementSettings {
  householdId String @id @db.Uuid

  rrspCurrentPlusContribCents   BigInt
  mortgageMonthlyCents          BigInt
  redirectYears                 Int
  flatGrowthPct                 Int
  /// Off by default: the sheet applies the growth once (section 14 q3).
  compoundYearly                Boolean @default(false)
  drawdownYears                 Int
  govPensionAnnualCents         BigInt
  retirementExpensesAnnualCents BigInt

  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedById String?  @db.Uuid

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("retirement_settings")
}

/* -------------------------------------------------------------------------- */
/* History and idempotency (HANDOFF section 16)                               */
/* -------------------------------------------------------------------------- */

/// APPEND-ONLY. Drives per-item history, the "who changed what" notices,
/// undo, and the conflict detection in section 16.3.
model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  householdId String         @db.Uuid
  userId      String         @db.Uuid
  at          DateTime       @default(now()) @db.Timestamptz(6)
  action      ActivityAction
  entity      String
  entityId    String         @db.Uuid
  /// The row version this change produced, so a conflict check can ask what
  /// happened since the version the client saw.
  versionAfter Int
  /// Exactly which fields this change touched. Same-field overlap is a 409;
  /// no overlap auto-merges.
  fields      String[]
  beforeJson  Json?
  afterJson   Json?
  /// What the thing was called when this happened - "Mortgage", "Chequing".
  /// Written here rather than looked up later, because a log that reads back
  /// through live rows reports today's name for yesterday's event, and says
  /// nothing at all once the row is gone.
  label       String?
  /// What sort of thing it was, in the household's own words: "bill",
  /// "payday", "work expense", "balance". The verb depends on it - a
  /// paycheque is received where a bill is paid.
  labelKind   String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([entity, entityId, versionAfter])
  @@index([householdId, at])
  @@map("activity")
}

/// One browser, signed up for notifications.
///
/// Per browser rather than per person: the same person on a phone and a
/// laptop is two subscriptions, and turning notifications off on one must not
/// turn them off on the other. `endpoint` is the push service's own URL for
/// that browser and is unique by definition, which is what makes re-saving an
/// unchanged subscription harmless.
///
/// Nothing here is a secret of ours - the keys are the browser's own public
/// key and auth secret, used to encrypt a payload only that browser can read.
/// Deleted outright rather than soft-deleted: a dead endpoint is not history
/// worth keeping, and the push service tells us when one has gone.
model PushSubscription {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  /// The push service URL. Unique across every user and device.
  endpoint  String @unique
  p256dh    String
  auth      String
  /// Which browser this is, so a person can tell their devices apart.
  userAgent String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  /// The last time the push service accepted a notification for it.
  lastOkAt  DateTime? @db.Timestamptz(6)
  /// Consecutive failures. A subscription the service rejects is removed.
  failures  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

/// One row per mutating request. A replay returns the stored response; the
/// same key with a different body is a 422. Purged after the configured TTL.
model IdempotencyKey {
  key          String   @id @db.Uuid
  userId       String   @db.Uuid
  method       String
  path         String
  requestHash  String
  statusCode   Int
  responseJson Json
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("idempotency_key")
}
