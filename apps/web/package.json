{
  "name": "@headroom/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headroom web app / PWA. Phone first, desktop second.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@headroom/core": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
